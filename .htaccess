# Nothing at the project root should ever be served directly — the app lives
# in public/. This blocks direct access to .env and other project files
# (defense in depth) and sends every other request into public/ so URLs
# work without typing /public/ explicitly.

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|json|lock|yml|yaml|log|md|dist|xml)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/xplatform-main/public
    RewriteRule ^(.*)$ /xplatform-main/public/$1 [R=302,L]
</IfModule>
